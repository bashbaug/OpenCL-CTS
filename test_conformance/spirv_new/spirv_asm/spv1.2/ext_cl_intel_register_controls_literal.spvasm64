               OpCapability Addresses
               OpCapability Kernel
               OpCapability RegisterLimitsINTEL
               OpExtension "SPV_INTEL_maximum_registers"
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %kernel "test"
               OpExecutionMode %kernel MaximumRegistersINTEL 256
       %uint = OpTypeInt 32 0
       %void = OpTypeVoid
   %gptr_int = OpTypePointer CrossWorkgroup %uint
 %kernel_sig = OpTypeFunction %void %gptr_int
     %kernel = OpFunction %void None %kernel_sig
        %dst = OpFunctionParameter %gptr_int
      %entry = OpLabel
               OpReturn
               OpFunctionEnd
